{
  "name": "postgres-schema-gallery",
  "version": "0.1.0",
  "private": true,
  "description": "Real PostgreSQL schemas behind well-known open-source products, documented and reviewed by db-architecture-review, with a rotatable 3D explorer each.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning build/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "playwright": "1.58.2",
    "prisma": "6.19.3",
    "typescript": "7.0.2"
  }
}
